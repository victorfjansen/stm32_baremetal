#include "stm32f4xx.h"

#define GPIOAEN 		(1U<<0)
#define UART2EN			(1U<<17)

#define CR1_TE			(1U<<3)
#define CR1_UE			(1U<<13)
#define SR_TXE			(1U<<7)

#define SYS_FREQ		16000000
#define APB1_CLK		SYS_FREQ

#define UART_BAUDRATE	115200

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t periphClk, uint32_t baudRate);
static uint16_t compute_uart_bd(uint32_t periphClk, uint32_t baudRate);
static void uart2_tx_init(void);
static void uart_write(int ch);

int main(void) {
	uart2_tx_init();

	while(1) {
		uart_write('Y');
	}

}

static void uart2_tx_init(void) {
	/**configure UART GPIO pin**/
	// enable clock access to GPIOA
	// Set PA2 mode to alternate function mode
	// set PA2 alternate function type to UART tx

	RCC->AHB1ENR |= GPIOAEN;

	//MODER to alternate function for PA2 is 10 on pint 5 and 4
	GPIOA->MODER &=~(1U<<4);
	GPIOA->MODER |= (1U<<5);


	// AFRL 2 -- mode 7 - 0111 starting from 11 pin to 8 pin (4its) - tx mode
	GPIOA->AFR[0] &=~(1U<<11);
	GPIOA->AFR[0] |=(1U<<10);
	GPIOA->AFR[0] |=(1U<<9);
	GPIOA->AFR[0] |=(1U<<8);

	/**Enable clock access to uart2 **/
	RCC->APB1ENR |= UART2EN;
	// Configure UART baudrate
	uart_set_baudrate(USART2, APB1_CLK, UART_BAUDRATE);
	//Configure the transfer direction
	USART2->CR1 = CR1_TE;

	// enable the uart module
	USART2->CR1 |= CR1_UE;

}

static void uart2_write(int ch) {
	/*
	 * Make sure the transmit data register is empty (SR: status registry)
	 */
	while((!(USART2->SR & SR_TXE))) {}

	/*Write to transmit data register*/
	// Boolean logic to limit 8 bit
	USART2->DR = (ch & 0xFF);


}

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t periphClk, uint32_t baudRate) {
	USARTx->BRR = compute_uart_bd(periphClk, baudRate);
}

static uint16_t compute_uart_bd(uint32_t periphClk, uint32_t baudRate) {
	return (periphClk + (baudRate/2U))/baudRate;
}
